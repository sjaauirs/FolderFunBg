<Page
    x:Class="FolderFunBg.Settings.Pages.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FolderFunBg.Settings.Models">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock
                Text="Folder backgrounds"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <Button Content="Add folder" Click="AddFolder_Click" />
            <Button
                Content="Apply changes"
                Click="Apply_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsOpen="False"
            Margin="0,12,0,12" />

        <TextBlock
            Grid.Row="2"
            Text="Backgrounds render beneath file names. In the GDI fallback mode, center, stretch, and zoom-fill can cover names; use a corner position or lower alpha."
            TextWrapping="Wrap"
            Opacity="0.75"
            Margin="0,0,0,12" />

        <ListView
            Grid.Row="3"
            ItemsSource="{x:Bind Rules}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FolderRuleItem">
                    <Grid Padding="12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="120"
                            Height="90"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Image
                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                Text="{x:Bind DisplayPath}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    Width="200"
                                    Header="Image"
                                    PlaceholderText="Use default"
                                    ItemsSource="{x:Bind ImageOptions}"
                                    SelectedItem="{x:Bind Image, Mode=TwoWay}" />
                                <ComboBox
                                    Width="150"
                                    Header="Position"
                                    ItemsSource="{x:Bind PositionOptions}"
                                    SelectedItem="{x:Bind Position, Mode=TwoWay}" />
                                <NumberBox
                                    Width="120"
                                    Header="Alpha"
                                    Minimum="0"
                                    Maximum="255"
                                    Value="{x:Bind Alpha, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Recursive"
                                    IsOn="{x:Bind Recursive, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Enabled"
                                    IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    Width="150"
                                    Header="Readability"
                                    ItemsSource="{x:Bind ReadabilityModeOptions}"
                                    SelectedItem="{x:Bind ReadabilityMode, Mode=TwoWay}" />
                                <NumberBox
                                    Width="130"
                                    Header="Scrim strength"
                                    Minimum="0"
                                    Maximum="255"
                                    Value="{x:Bind ReadabilityStrength, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="Remove"
                            Click="Remove_Click"
                            Tag="{x:Bind}"
                            VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
